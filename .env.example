DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recruitment

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]

# Per-file size limit for uploaded resumes (files are stored in the database)
MAX_RESUME_MB=10

LOG_DIR=logs
LOG_LEVEL=INFO

# Azure OpenAI (resume extraction)
# Endpoint and Key 1 from the resource's Keys and Endpoint page
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=resume-extractor
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure Document Intelligence (resume text extraction)
# Endpoint and Key 1 from the resource's Keys and Endpoint page
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout

# Microsoft Foundry resume-scorer agent (resume scoring)
# Project endpoint from the Foundry project's Overview page. Authentication is Entra ID:
# run `az login` locally (your account needs the Azure AI User role on the project).
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
SCORING_AGENT_NAME=resume-scorer
# Leave empty for the latest version; pin it so scores stay comparable
SCORING_AGENT_VERSION=
SCORING_MAX_CONCURRENCY=4
